<?xml version="1.0" encoding="UTF-8"?>
<GlobalVariableEntities>
<description>Public demo, local Web Desktop execution</description><name>default</name><tag></tag><defaultProfile>true</defaultProfile>
<GlobalVariableEntity><description>Target URL with trailing slash</description><initValue>'https://www.saucedemo.com/'</initValue><name>baseUrl</name></GlobalVariableEntity>
<GlobalVariableEntity><description>Public demo username, not production credentials</description><initValue>'standard_user'</initValue><name>username</name></GlobalVariableEntity>
<GlobalVariableEntity><description>Public demo password; do not store real secrets here</description><initValue>'secret_sauce'</initValue><name>password</name></GlobalVariableEntity>
<GlobalVariableEntity><description>Explicit wait timeout in seconds</description><initValue>15</initValue><name>timeout</name></GlobalVariableEntity>
</GlobalVariableEntities>
